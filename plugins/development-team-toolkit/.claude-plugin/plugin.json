{
  "name": "development-team-toolkit",
  "version": "0.8.0",
  "description": "Portable development team workflows and specialists.",
  "license": "Apache-2.0",
  "keywords": [
    "project-management",
    "handoff",
    "review",
    "coordination"
  ],
  "mcpServers": {
    "coordinator": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/coordinator-mcp.mjs"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/role-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
